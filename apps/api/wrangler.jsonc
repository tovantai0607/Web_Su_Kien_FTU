{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ftucharm",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "vars": {
    "DEMO_MODE": "false",
    "PUBLIC_EDITION_SLUG": "ftucharm-2027",
    "ALLOWED_ORIGIN": "https://configure-your-domain.example",
    "SUPABASE_URL": "https://ifgtyslifgegwcguysbb.supabase.co",
    "SUPABASE_JWKS_URL": "https://ifgtyslifgegwcguysbb.supabase.co/auth/v1/.well-known/jwks.json",
  },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "triggers": { "crons": ["* * * * *"] },
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
  ],
  // Run with --env demo-test --local. Images and MEDIA stay on this computer;
  // Supabase writes are real and restricted to the user-approved DEMO workflow.
  "env": {
    "online-test": {
      "name": "ftucharm-test",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "../../dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "vars": {
        "DEMO_MODE": "false",
        "PUBLIC_EDITION_SLUG": "ftucharm-2027",
        "ALLOWED_ORIGIN": "https://ftucharm-test.bancotaima1235.workers.dev",
        "SUPABASE_URL": "https://ifgtyslifgegwcguysbb.supabase.co",
        "SUPABASE_JWKS_URL": "https://ifgtyslifgegwcguysbb.supabase.co/auth/v1/.well-known/jwks.json",
        "TURNSTILE_HOSTNAME": "ftucharm-test.bancotaima1235.workers.dev",
      },
      // No R2/Images subscription: upload endpoints fail closed with 503.
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
      ],
      // Test URL uses the existing database: do not send queued email or run jobs.
      "triggers": { "crons": [] },
    },
    "official-local": {
      "name": "ftucharm-official-local",
      "main": "src/index.ts",
      "assets": {
        "directory": "../../dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
      },
      "vars": {
        "DEMO_MODE": "false",
        "PUBLIC_EDITION_SLUG": "ftucharm-2027",
        "ALLOWED_ORIGIN": "http://127.0.0.1:5173",
        "SUPABASE_URL": "https://ifgtyslifgegwcguysbb.supabase.co",
        "SUPABASE_JWKS_URL": "https://ifgtyslifgegwcguysbb.supabase.co/auth/v1/.well-known/jwks.json",
      },
      "images": { "binding": "IMAGES", "remote": false },
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "ftu-official-media-local", "remote": false },
      ],
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } },
      ],
      "triggers": { "crons": [] },
    },
    "demo-test": {
      "name": "ftucharm-demo-test-local",
      "main": "src/demo-test.ts",
      "vars": {
        "DEMO_MODE": "false",
        "DEMO_TEST_OFFER_SLUG": "test-giao-dich-demo",
        "ALLOWED_ORIGIN": "http://127.0.0.1:5173",
        "SUPABASE_URL": "https://ifgtyslifgegwcguysbb.supabase.co",
        "SUPABASE_JWKS_URL": "https://ifgtyslifgegwcguysbb.supabase.co/auth/v1/.well-known/jwks.json",
      },
      "images": { "binding": "IMAGES", "remote": false },
      "r2_buckets": [
        { "binding": "MEDIA", "bucket_name": "ftu-demo-proof-local", "remote": false },
      ],
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
      ],
      "triggers": { "crons": [] },
    },
  },
}
