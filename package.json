{
  "name": "ftucharm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:api": "wrangler dev --config apps/api/wrangler.jsonc",
    "build": "vite build --config apps/web/vite.config.ts",
    "build:preview": "node scripts/build-preview.mjs",
    "preview": "vite preview --config apps/web/vite.config.ts --outDir ../../dist-preview --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "node tests/load/local-load.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "db:test": "node scripts/test-database.mjs",
    "lint": "eslint apps packages tests *.config.ts",
    "format": "prettier --write apps packages tests scripts docs *.json *.ts *.mjs .github/workflows/ci.yml",
    "format:check": "prettier --check apps packages tests scripts docs *.json *.ts *.mjs .github/workflows/ci.yml"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20261013.1",
    "@electric-sql/pglite": "0.5.9",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/playfair-display": "5.3.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-toast": "1.3.1",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-query": "5.104.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "lucide-react": "1.56.0",
    "motion": "14.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.90.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  }
}
